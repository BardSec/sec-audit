# create-vm configuration (Proxmox)
# Copy this file to create-vm.conf and edit as needed.

# =============================================================================
# Proxmox Connection
# =============================================================================

# REQUIRED: Proxmox host address and credentials
PVE_HOST=""                      # e.g., "192.168.1.87" or Tailscale IP
PVE_PORT=8006
PVE_USER="root@pam"
PVE_PASSWORD=""

# Node name — auto-detected from API if empty
# PVE_NODE=""                    # e.g., "proxmox"

# =============================================================================
# VM Placement
# =============================================================================

# REQUIRED: Storage and network for new VMs
PVE_STORAGE="local-lvm"         # Storage for VM disks (LVM, ZFS, Ceph, etc.)
PVE_ISO_STORAGE="local"         # Storage for cloud image downloads (needs 'iso' content type)
PVE_BRIDGE="vmbr0"              # Network bridge
# PVE_VLAN=""                   # VLAN tag (e.g., "40"), leave empty for untagged

# =============================================================================
# VM Defaults
# =============================================================================

# These can be overridden per-VM via command line flags
# VM_CPU=2                       # Number of vCPUs
# VM_MEMORY=4096                 # Memory in MB
# VM_DISK=50                     # Disk size in GB

# Static IP (optional — omit for DHCP)
# VM_IP="192.168.40.10/24"      # CIDR notation
# VM_GATEWAY="192.168.40.1"
# VM_NAMESERVER="192.168.40.1"

# =============================================================================
# Ubuntu User
# =============================================================================

VM_USER="andylombardo"

# SSH public key — defaults to ~/.ssh/id_ed25519.pub if not set
# VM_SSH_PUBKEY="ssh-ed25519 AAAA... user@host"

# =============================================================================
# Tailscale (optional)
# =============================================================================

# Pre-authenticated auth key so the VM joins your tailnet automatically.
# Without this, you'll need to SSH via IP and run 'sudo tailscale up' manually.
#
# Create one at: https://login.tailscale.com/admin/settings/keys
# Recommended: reusable key (NOT ephemeral)
#
# TAILSCALE_AUTH_KEY="tskey-auth-..."

# =============================================================================
# Post-Provision
# =============================================================================

# RUN_SERVER_INIT=true           # Run server-init.sh after VM boots
# RUN_SEC_AUDIT=true             # Run sec-audit.sh --harden after server-init
# SEC_AUDIT_REPO="https://github.com/BardSec/sec-audit.git"
