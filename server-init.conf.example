# server-init configuration
# Copy this file to server-init.conf and edit as needed.
# All values below are the defaults — uncomment and change to override.

# =============================================================================
# Components to install
# =============================================================================

# INSTALL_DOCKER=true            # Docker Engine + Compose plugin
# INSTALL_TAILSCALE=true         # Tailscale VPN
# INSTALL_GH=true                # GitHub CLI
# INSTALL_CLOUDFLARED=true       # Cloudflare Tunnel client

# =============================================================================
# Cloudflare Tunnel
# =============================================================================

# Two options for setting up a Cloudflare tunnel:
#
# --- OPTION A: Fully automated via API (recommended) ---
#
# The script will auto-create a tunnel named after the server's hostname
# (or CLOUDFLARE_TUNNEL_NAME if set), fetch the token, and install the service.
#
# CLOUDFLARE_API_TOKEN=""         # API token (see below for how to create)
# CLOUDFLARE_ACCOUNT_ID=""        # Your Cloudflare account ID
# CLOUDFLARE_TUNNEL_NAME=""       # Tunnel name (defaults to hostname)
#
# How to get your API token:
#   1. Go to https://dash.cloudflare.com/profile/api-tokens
#   2. Click "Create Token"
#   3. Use "Create Custom Token"
#   4. Set permissions: Account → Cloudflare Tunnel → Edit
#   5. (Optional) Add Account → Account Settings → Read if you want
#      the script to verify the account ID
#   6. Click "Continue to summary" → "Create Token"
#   7. Copy the token value
#
# How to get your Account ID:
#   1. Go to https://dash.cloudflare.com
#   2. Click on any domain
#   3. Your Account ID is in the right sidebar under "API"
#   OR: it's in the URL: https://dash.cloudflare.com/<account-id>
#
# --- OPTION B: Manual token from dashboard ---
#
# If you prefer to create tunnels manually in the dashboard:
#   1. Go to https://one.dash.cloudflare.com → Networks → Tunnels
#   2. Create a tunnel (or select an existing one)
#   3. Copy the token from the "Install connector" step
#
# CLOUDFLARED_TOKEN="eyJhIjoi..."

# =============================================================================
# Git configuration
# =============================================================================

# GIT_USER_NAME="Your Name"
# GIT_USER_EMAIL="you@example.com"

# =============================================================================
# User setup
# =============================================================================

# SETUP_USER="andylombardo"      # Username to configure
# ADD_TO_DOCKER_GROUP=true       # Add user to docker group
# SETUP_NOPASSWD_SUDO=false     # Grant NOPASSWD sudo access

# SSH public key to add to authorized_keys (paste the full key here)
# SSH_AUTHORIZED_KEY="ssh-ed25519 AAAA... user@host"

# =============================================================================
# Extra packages
# =============================================================================

# Add any additional apt packages you want installed
# EXTRA_PACKAGES=(vim tmux rsync)

# =============================================================================
# Baseline packages (override the default list if needed)
# =============================================================================

# BASELINE_PACKAGES=(
#     curl
#     wget
#     git
#     htop
#     unzip
#     jq
#     tree
